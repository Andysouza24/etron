# .easignore — replaces .gitignore for EAS Build uploads
# Reduces upload size to speed up builds

# dependencies (installed on EAS)
node_modules/

# Expo dev cache
.expo/
dist/
web-build/

# Native dirs (regenerated via prebuild on EAS)
android/
ios/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# IDEs
.vscode/

# build artifacts
build/

# === Additional exclusions (not in .gitignore) ===

# Tests — not needed for native builds
__tests__/

# Documentation
README.md
components/BottomSheet/readme.md

# Linting config — not used during builds
eslint.config.js

# Amplify backend deployment — only for AWS CI/CD, not mobile builds
amplify-backend/

# Amplify ignore paths
amplify/\#current-cloud-backend
amplify/.config/local-*
amplify/logs
amplify/mock-data
amplify/mock-api-resources
amplify/backend/amplify-meta.json
amplify/backend/.temp
aws-exports.js
awsconfiguration.json
amplifyconfiguration.json
amplifyconfiguration.dart
amplify-build-config.json
amplify-gradle-config.json
amplifytools.xcconfig
.secret-*
**.sample

# Misc artifacts
$null
.yarnclean
