{
  "cli": {
    "version": ">= 16.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "yarn": "1.22.22",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "ios": {
        "cache": {
          "paths": [
            "./ios/Podfile.lock"
          ]
        }
      }
    },
    "development-large": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "yarn": "1.22.22",
      "resourceClass": "large",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "ios": {
        "cache": {
          "paths": [
            "./ios/Podfile.lock"
          ]
        }
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "yarn": "1.22.22",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "ios": {
        "cache": {
          "paths": [
            "./ios/Podfile.lock"
          ]
        }
      }
    },
    "preview-apk": {
      "channel": "preview",
      "distribution": "internal",
      "yarn": "1.22.22",
      "resourceClass": "large",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "yarn": "1.22.22",
      "resourceClass": "large",
      "env": {
        "EAS_RESTORE_CACHE": "0",
        "EAS_SAVE_CACHE": "1"
      },
      "ios": {
        "cache": {
          "paths": [
            "./ios/Podfile.lock"
          ]
        }
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
