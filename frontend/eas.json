{
  "cli": {
    "version": ">= 16.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "yarn": "1.22.22",
      "resourceClass": "medium",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "paths": [
          "./ios/Podfile.lock"
        ]
      },
      "channel": "development"
    },
    "development-large": {
      "developmentClient": true,
      "distribution": "internal",
      "yarn": "1.22.22",
      "resourceClass": "large",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "paths": [
          "./ios/Podfile.lock"
        ]
      },
      "channel": "development-large"
    },
    "preview": {
      "distribution": "internal",
      "yarn": "1.22.22",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "paths": [
          "./ios/Podfile.lock"
        ]
      },
      "channel": "preview"
    },
    "preview-apk": {
      "distribution": "internal",
      "yarn": "1.22.22",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "disabled": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-apk"
    },
    "production": {
      "autoIncrement": true,
      "yarn": "1.22.22",
      "resourceClass": "large",
      "env": {
        "EAS_RESTORE_CACHE": "0",
        "EAS_SAVE_CACHE": "1"
      },
      "cache": {
        "paths": [
          "./ios/Podfile.lock"
        ]
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
